################################################################################
# CareerOS AI - Environment Variables
#
# Setup:
#   1. Copy this file:  cp .env.example .env     (Windows: copy .env.example .env)
#   2. Fill in your real values below
#   3. NEVER commit .env to GitHub — it is already listed in .gitignore
################################################################################

# ------------------------------------------------------------------------------
# AI MODEL (REQUIRED)
# Google Gemini — get your API key here:
#   https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=

# Which Gemini model powers all 5 agents.
# Options: gemini-3.6-flash (default), gemini-3.7-flash, gemini-2.5-pro,
#          or gemini-flash-latest (Google's auto-updating Flash alias)
GEMINI_MODEL=gemini-3.6-flash

# Sampling settings for the agents.
# 0.2 is recommended: lower temperature = more reliable JSON output.
GEMINI_TEMPERATURE=0.2

# Maximum tokens per agent response.
# Note: Gemini "thinking" models also spend thinking tokens from this
# budget, so keep it generous (8192 is safe for the big Master agent report).
GEMINI_MAX_TOKENS=8192

# ------------------------------------------------------------------------------
# GITHUB API (OPTIONAL)
# Without a token you get 60 requests/hour (fine for demos).
# With a token you get 5000/hour. Create one at:
#   https://github.com/settings/tokens  (no extra scopes needed for public data)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

GITHUB_TIMEOUT=15
GITHUB_MAX_REPOS=8

# ------------------------------------------------------------------------------
# UPLOADS & SERVER (OPTIONAL — defaults are fine for local development)
# ------------------------------------------------------------------------------
MAX_RESUME_MB=10
MAX_RESUME_CHARS=12000
API_HOST=127.0.0.1
API_PORT=8000
