################################################################################
# CareerOS AI - Environment Variables Configuration
# 
# This file shows all required environment variables.
# 
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. NEVER commit .env to GitHub (only commit .env.example)
# 4. Add to .gitignore: .env (keep secrets private!)
#
################################################################################

################################################################################
# 🤖 AI/LLM CONFIGURATION
################################################################################

# Claude API Key (from Anthropic)
# Get at: https://console.anthropic.com/
# Format: sk-ant-...
# Required: YES
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here

# Claude Model Version
# Options: claude-3-5-sonnet-20241022, claude-3-opus-20250219, etc.
# Required: YES
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Maximum tokens for Claude responses
# Recommended: 2048 (adjust based on needs)
# Required: NO (default: 2048)
CLAUDE_MAX_TOKENS=2048

# Temperature for Claude (creativity level)
# Range: 0.0 (deterministic) to 1.0 (creative)
# Recommended: 0.7
# Required: NO (default: 0.7)
CLAUDE_TEMPERATURE=0.7

################################################################################
# 🗄️ DATABASE CONFIGURATION
################################################################################

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:pass@localhost:5432/careeros_db
# Required: YES
DATABASE_URL=postgresql://user:password@localhost:5432/careeros_db

# Database Host
# Default: localhost (for local development)
# Production: your-database-host.com
# Required: NO (derived from DATABASE_URL if set)
DB_HOST=localhost

# Database Port
# Default: 5432 (PostgreSQL default)
# Required: NO (derived from DATABASE_URL if set)
DB_PORT=5432

# Database Name
# Required: NO (derived from DATABASE_URL if set)
DB_NAME=careeros_db

# Database Username
# Required: NO (derived from DATABASE_URL if set)
DB_USER=postgres

# Database Password
# ⚠️ KEEP THIS SECRET - Never commit real password!
# Required: NO (derived from DATABASE_URL if set)
DB_PASSWORD=your-database-password

# Database Connection Pool Size
# Recommended: 10-20
# Required: NO (default: 10)
DB_POOL_SIZE=10

# Enable Database SSL
# Options: True, False
# Use True for production
# Required: NO (default: False)
DB_SSL=False

################################################################################
# 💾 CACHE CONFIGURATION (Redis)
################################################################################

# Redis URL
# Format: redis://username:password@host:port/database
# Example: redis://localhost:6379/0
# Required: YES (for caching)
REDIS_URL=redis://localhost:6379/0

# Redis Host
# Default: localhost
# Production: your-redis-host.com
# Required: NO (derived from REDIS_URL if set)
REDIS_HOST=localhost

# Redis Port
# Default: 6379
# Required: NO (derived from REDIS_URL if set)
REDIS_PORT=6379

# Redis Password (if authentication required)
# Leave empty if no password
# Required: NO
REDIS_PASSWORD=

# Redis Database Number
# Default: 0
# Required: NO
REDIS_DB=0

# Cache Expiration Time (in seconds)
# 3600 = 1 hour, 86400 = 1 day
# Recommended: 3600
# Required: NO (default: 3600)
CACHE_EXPIRATION_SECONDS=3600

################################################################################
# 🌐 GITHUB INTEGRATION
################################################################################

# GitHub Personal Access Token
# Get at: https://github.com/settings/tokens
# Scopes needed: repo, user, read:user
# Required: YES (for GitHub analysis)
GITHUB_TOKEN=ghp_your-github-personal-access-token-here

# GitHub API Version
# Current: v3
# Required: NO (default: v3)
GITHUB_API_VERSION=v3

################################################################################
# 🖥️ SERVER CONFIGURATION
################################################################################

# Environment Type
# Options: development, staging, production
# Required: YES
ENVIRONMENT=development

# Debug Mode
# Options: True, False
# Set False in production
# Required: NO (default: False)
DEBUG=False

# API Server Host
# 0.0.0.0 = accessible from all IPs (development)
# 127.0.0.1 = localhost only
# Required: NO (default: 0.0.0.0)
API_HOST=0.0.0.0

# API Server Port
# Development: 8000
# Production: Usually 80 or 443
# Required: NO (default: 8000)
API_PORT=8000

# API Base URL
# For frontend to know where API is
# Development: http://localhost:8000
# Production: https://api.careeros.ai
# Required: NO
API_BASE_URL=http://localhost:8000

# CORS Allowed Origins
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://careeros.ai
# Required: NO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# CORS Allow Credentials
# Options: True, False
# Required: NO (default: False)
CORS_ALLOW_CREDENTIALS=False

# API Rate Limit (requests per minute)
# Recommended: 60
# Required: NO (default: 60)
API_RATE_LIMIT=60

################################################################################
# 🔐 SECURITY CONFIGURATION
################################################################################

# Secret Key for JWT Tokens
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ KEEP THIS SECRET
# Required: YES
SECRET_KEY=your-super-secret-key-here-change-in-production

# JWT Algorithm
# Options: HS256, HS384, HS512
# Recommended: HS256
# Required: NO (default: HS256)
JWT_ALGORITHM=HS256

# JWT Expiration Time (in seconds)
# 3600 = 1 hour, 86400 = 1 day
# Recommended: 3600
# Required: NO (default: 3600)
JWT_EXPIRATION_SECONDS=3600

# Allowed Origins for API Requests
# Set this for CORS security
# Required: NO
ALLOWED_ORIGINS=localhost,127.0.0.1

################################################################################
# 📧 EMAIL CONFIGURATION (Optional)
################################################################################

# SMTP Server Host
# Example: smtp.gmail.com
# Required: NO (for email features)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port
# Gmail: 587 (TLS) or 465 (SSL)
# Default: 587
# Required: NO
SMTP_PORT=587

# SMTP Username/Email
# Example: your-email@gmail.com
# Required: NO
SMTP_USERNAME=your-email@gmail.com

# SMTP Password
# ⚠️ For Gmail: Use App Password, not regular password
# Required: NO
SMTP_PASSWORD=your-app-password

# From Email Address
# For sending emails
# Required: NO
FROM_EMAIL=noreply@careeros.ai

# Email Verification
# Options: True, False
# Require email verification for signup
# Required: NO (default: True)
EMAIL_VERIFICATION_REQUIRED=True

################################################################################
# 📊 LOGGING CONFIGURATION
################################################################################

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: INFO (development), WARNING (production)
# Required: NO (default: INFO)
LOG_LEVEL=INFO

# Log File Path
# Where to save log files
# Example: /var/log/careeros/app.log
# Required: NO
LOG_FILE_PATH=logs/app.log

# Log Format
# Options: json, text
# Recommended: json (production), text (development)
# Required: NO (default: text)
LOG_FORMAT=text

################################################################################
# ☁️ CLOUD STORAGE CONFIGURATION (Optional)
################################################################################

# AWS S3 Bucket Name
# For storing uploaded resumes, documents
# Required: NO (if using local storage)
AWS_S3_BUCKET=careeros-ai-uploads

# AWS Region
# Example: us-east-1, eu-west-1
# Required: NO
AWS_REGION=us-east-1

# AWS Access Key ID
# ⚠️ KEEP THIS SECRET
# Required: NO
AWS_ACCESS_KEY_ID=your-aws-access-key-here

# AWS Secret Access Key
# ⚠️ KEEP THIS SECRET
# Required: NO
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here

# AWS Endpoint (for local testing with LocalStack)
# Example: http://localhost:4566
# Leave empty for production AWS
# Required: NO
AWS_ENDPOINT_URL=

# File Storage Type
# Options: local, s3
# Recommended: local (development), s3 (production)
# Required: NO (default: local)
FILE_STORAGE_TYPE=local

# Local File Storage Path
# Where to save files locally
# Required: NO (if using local storage)
LOCAL_FILE_STORAGE_PATH=uploads/

# Max File Upload Size (in MB)
# Example: 10 (= 10 MB max)
# Required: NO (default: 10)
MAX_FILE_UPLOAD_SIZE=10

################################################################################
# 📱 FRONTEND CONFIGURATION (If React running locally)
################################################################################

# React App API URL
# Set in frontend .env for API calls
# Example: http://localhost:8000
# Required: NO (frontend only)
REACT_APP_API_URL=http://localhost:8000

# React App Environment
# Options: development, production
# Required: NO (frontend only)
REACT_APP_ENV=development

################################################################################
# 🧪 TESTING CONFIGURATION
################################################################################

# Test Database URL
# Separate database for running tests
# Example: postgresql://user:pass@localhost:5432/careeros_test
# Required: NO (for testing)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/careeros_test

# Test Redis URL
# Separate Redis for testing
# Required: NO (for testing)
TEST_REDIS_URL=redis://localhost:6380/0

# Test Mode
# Options: True, False
# Set True when running tests
# Required: NO (default: False)
TEST_MODE=False

################################################################################
# 🔔 NOTIFICATION CONFIGURATION (Optional)
################################################################################

# Webhook URL for notifications
# Example: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Required: NO
WEBHOOK_URL=

# Notification Service
# Options: email, slack, discord, none
# Required: NO (default: none)
NOTIFICATION_SERVICE=none

################################################################################
# 📈 ANALYTICS CONFIGURATION (Optional)
################################################################################

# Sentry DSN (for error tracking)
# Get at: https://sentry.io/
# Required: NO
SENTRY_DSN=

# Google Analytics ID
# Example: G-XXXXXXXXXX
# Required: NO
GOOGLE_ANALYTICS_ID=

################################################################################
# 🎯 APPLICATION-SPECIFIC CONFIGURATION
################################################################################

# API Timeout (in seconds)
# For requests to external APIs
# Recommended: 30
# Required: NO (default: 30)
API_TIMEOUT=30

# Max Concurrent Agents
# How many agents can run simultaneously
# Recommended: 5
# Required: NO (default: 5)
MAX_CONCURRENT_AGENTS=5

# Resume Analysis Timeout (in seconds)
# Maximum time for resume analysis
# Recommended: 60
# Required: NO (default: 60)
RESUME_ANALYSIS_TIMEOUT=60

# GitHub Analysis Timeout (in seconds)
# Maximum time for GitHub repo analysis
# Recommended: 120
# Required: NO (default: 120)
GITHUB_ANALYSIS_TIMEOUT=120

# Cache Analysis Results
# Options: True, False
# Whether to cache analysis results
# Required: NO (default: True)
CACHE_ANALYSIS_RESULTS=True

################################################################################
# 🌍 DEPLOYMENT CONFIGURATION
################################################################################

# Application Name
# For logging and identification
# Required: NO (default: CareerOS AI)
APP_NAME=CareerOS AI

# Application Version
# Current release version
# Required: NO (default: 0.1.0)
APP_VERSION=0.1.0

# Domain Name
# Production domain
# Example: careeros.ai
# Required: NO
DOMAIN_NAME=localhost

# Deployment Platform
# Options: local, docker, heroku, aws, gcp, azure
# Required: NO (default: local)
DEPLOYMENT_PLATFORM=local

################################################################################
# 📝 NOTES AND GUIDELINES
################################################################################

# SECURITY REMINDERS:
# 1. Never commit .env file to GitHub (add to .gitignore)
# 2. Only commit .env.example (no secrets!)
# 3. Keep API keys and passwords secure
# 4. Use different keys for development/staging/production
# 5. Rotate keys regularly in production
# 6. Use environment variables, not hardcoded values

# GETTING STARTED:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Add to .gitignore: .env
# 4. Run: python src/main.py

# FOR DEVELOPMENT:
# - Use localhost for DB and Redis
# - Set DEBUG=True for better error messages
# - Use local file storage (FILE_STORAGE_TYPE=local)

# FOR PRODUCTION:
# - Use strong passwords and secret keys
# - Set DEBUG=False
# - Use cloud storage (S3)
# - Enable SSL/TLS
# - Use environment-specific secrets manager

################################################################################
